{
  "name": "yanlin-gta",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:wasm": "node tools/check_wasm.mjs",
    "check:dist": "node tools/check_dist.mjs",
    "wiki:build": "node wiki/build.mjs",
    "profile:scene": "node tools/profile_scene.mjs",
    "profile:mobile": "node tools/profile_scene.mjs --mobile --markdown",
    "profile:desktop": "node tools/profile_scene.mjs --gpu --markdown",
    "profile:safari": "node tools/profile_scene.mjs --engine=webkit --mobile --markdown",
    "profile:webkit-install": "playwright-core install webkit",
    "bench:iphone": "node tools/run_bench.mjs",
    "bench:desktop": "node tools/run_bench.mjs --desktop",
    "perf:attach": "node tools/perf_history.mjs attach",
    "perf:history": "node tools/perf_history.mjs list",
    "perf:compare": "node tools/perf_history.mjs compare",
    "test:e2e": "node tools/e2e/story-bot.mjs",
    "test:smoke": "node tools/e2e/smoke.mjs",
    "ci": "npm run format:check && npm run lint && npm test && npm run build && npm run check:dist"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/three": "^0.160.0",
    "eslint": "^9.15.0",
    "happy-dom": "^15.11.7",
    "playwright-core": "^1.65.1",
    "prettier": "^3.3.3",
    "sql.js": "^1.10.3",
    "vite": "^5.4.11",
    "vite-plugin-wasm": "^3.3.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "three": "^0.160.1",
    "trystero": "^0.27.0"
  }
}
